rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /requests/{requestId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
          ['hallId', 'date', 'startTime', 'endTime', 'requesterName', 'phone', 'unit', 'status']
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.hallId is string
        && request.resource.data.date is string
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9;

      allow update, delete: if request.auth != null;
    }
  }
}